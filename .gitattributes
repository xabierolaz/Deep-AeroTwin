# Keep WSL/Linux scripts in LF to avoid $'\r' errors under bash.
*.sh   text eol=lf
*.bash text eol=lf

# Keep Python files consistent across platforms.
*.py   text eol=lf
# Windows-native scripts.
*.bat  text eol=crlf
*.ps1  text eol=crlf
# Generated paper/media artifacts.
*.pdf binary
*.png binary
*.lib filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
