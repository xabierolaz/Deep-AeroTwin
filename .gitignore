# Root .gitignore: ignore build artifacts, caches and machine-local files.

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Virtual envs
.venv/
venv/
env/

# Env files (local)
.env
.env.*

# --- Editor/OS ---
.vscode/
.idea/
.vs/
.claude/
.fleet/
.spyproject/
.ropeproject/
.history/
*.code-workspace
Thumbs.db
.DS_Store

# --- Temporary files ---
*.tmp
*.bak
*.swp
*~
/tmp/

# --- LaTeX build artifacts ---
*.aux
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc
*.bcf
*.run.xml

# --- Logs / run artifacts ---
logs/
pipeline/logs/
pipeline/detection_results/
*.log
nul

# --- Runtime artifacts (local runs) ---
brain/
pipeline/brain/
pipeline/vision/
.migration/

# --- Local neural/video worktrees and model caches ---
neural/FlashVSR/
neural/VideoX-Fun/
neural/ckpts/
neural/models/
neural/wan_models/
neural/__pycache__/

# --- Unreal Engine ---
# Keep source/assets under Unreal/, ignore generated output (Binaries/Intermediate/Saved/DerivedDataCache) and IDE files.
Unreal/**/Binaries/
Unreal/**/Build/
Unreal/**/DerivedDataCache/
Unreal/**/Intermediate/
Unreal/**/Saved/

# --- Local paper/render scratch ---
/figures/
/paper_pipeline_B_telemetry_local_backup_*/
/semantic_proxy_3d_paper.*
/semantic_proxy_3d_references.bib
Unreal/**/.vs/
Unreal/**/.vscode/
Unreal/*.sln
Unreal/*.suo
Unreal/*.opensdf
Unreal/*.sdf
Unreal/*.VC.db
Unreal/*.VC.opendb

# --- Large files (avoid accidental commits without LFS) ---
*.fbx
*.bin
*.sqlite
*.sqlite-shm
*.sqlite-wal

# --- Dataset / training artifacts ---
3d_to_dataset_xabi/dataset/
3d_to_dataset_xabi/runs/
3d_to_dataset_xabi/venv/
3d_to_dataset_xabi/yolo_3d_experiment/
3d_to_dataset_xabi/__pycache__/
tools/detect/

# Keep YOLO workflow artifacts out of git by default (except curated final weights).
yolo/source/
yolo/dataset/
yolo/runs/
yolo/venv/
yolo/labels_backup_*/

# Keep paper-capture intermediates out of git; final paper artifacts stay under final_artifacts/ and Imagenes/.
figuras_paper_unreal_generadas/yolo_crossing_precheck/annotated/
figuras_paper_unreal_generadas/yolo_crossing_precheck/event_frames_fine/
figuras_paper_unreal_generadas/yolo_crossing_precheck/paper_candidates/
figuras_paper_unreal_generadas/yolo_crossing_precheck/raw/
figuras_paper_unreal_generadas/yolo_crossing_precheck/raw_unreal_foreground_peloton_candidates/
figuras_paper_unreal_generadas/yolo_crossing_precheck/raw_unreal_red_peloton_candidates/
figuras_paper_unreal_generadas/yolo_crossing_precheck/validated_video_frames/
figuras_paper_unreal_generadas/yolo_crossing_precheck/capture_manifest.json
figuras_paper_unreal_generadas/yolo_crossing_precheck/yolo_precheck_manifest.json
figuras_paper_unreal_generadas/yolo_crossing_precheck/yolo_crossing_precheck.mp4

# YOLO weights: ignore by default; allow committing only the canonical runtime weight.
*.pt
!yolo/weights/
!yolo/weights/yolo_unreal_unrealScene_v1_best_e23_2026-02-18.pt
