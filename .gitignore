# Root .gitignore: ignore build artifacts, caches and machine-local files.

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Virtual envs
.venv/
venv/
env/

# Env files (local)
.env
.env.*

# --- Editor/OS ---
.vscode/
.idea/
.vs/
.fleet/
.spyproject/
.ropeproject/
.history/
*.code-workspace
Thumbs.db
.DS_Store

# --- Temporary files ---
*.tmp
*.bak
*.swp

# --- Logs / run artifacts ---
logs/
pipeline/logs/
pipeline/detection_results/
*.log
nul

# --- Unreal Engine ---
# Keep source/assets under Unreal/, ignore generated output (Binaries/Intermediate/Saved/DerivedDataCache) and IDE files.
Unreal/**/Binaries/
Unreal/**/Build/
Unreal/**/DerivedDataCache/
Unreal/**/Intermediate/
Unreal/**/Saved/
Unreal/**/.vs/
Unreal/**/.vscode/
Unreal/*.sln
Unreal/*.suo
Unreal/*.opensdf
Unreal/*.sdf
Unreal/*.VC.db
Unreal/*.VC.opendb

# --- Large files (avoid accidental commits without LFS) ---
*.fbx
*.bin
*.sqlite
*.sqlite-shm
*.sqlite-wal

# --- Dataset / training artifacts ---
3d_to_dataset_xabi/dataset/
3d_to_dataset_xabi/runs/
3d_to_dataset_xabi/venv/
3d_to_dataset_xabi/yolo_3d_experiment/
3d_to_dataset_xabi/__pycache__/

# YOLO weights: ignore by default; allow committing a curated final weight in pipeline/weights.
*.pt
!pipeline/weights/
pipeline/weights/*.pt
!pipeline/weights/yolo_3d_dome_v1_best.pt
