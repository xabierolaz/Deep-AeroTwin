# Opt-in SPPA universal evidence profile.
# Load after pipeline\porce_defaults.env with FORCE_SET=1 when running the
# YOLOE/SPPA paper experiment. This preserves labels for audit while Brain
# applies its existing fallback safety distance to labels it does not
# explicitly know.

PORCE_YOLO_MODEL=%PROJECT_ROOT%\yoloe-26s-seg.pt
PORCE_YOLOE_ENABLE=1
PORCE_VISION_DET_CONF=0.05
PORCE_VISION_PUBLISH_CONF=0.35
PORCE_VISION_TARGET_CLASS_NAMES=biker,cow,tower
PORCE_VISION_CLASS_ALIASES=cyclist:biker,bicycle:biker,bike:biker,cattle:cow,vaca:cow,electric pylon:tower,power transmission tower:tower,utility pole:tower,pylon:tower,antenna tower:tower
PORCE_YOLOE_CLASS_NAMES=person,cyclist,bicycle,two-wheeled vehicle,motorcycle,vehicle,car,truck,bus,van,pickup truck,tractor,agricultural vehicle,trailer,construction vehicle,excavator,bulldozer,forklift,crane,power transmission tower,electric pylon,utility pole,antenna tower,road sign,building,house,barn,shed,warehouse,bridge,wall,fence,cow,cattle,horse,dog,sheep,animal,giraffe,zebra,elephant,tree,bush,vegetation,rock,boulder,container,shipping container,water tank,barrel,traffic cone,drone,quadcopter,UAV,hay bale

# Static labels are tracked with a longer TTL. Unknown labels still use the
# existing Brain fallback radius unless they are aliased above.
PORCE_OBS_STATIC_CLASS_NAMES=tower,cow,building,house,barn,shed,warehouse,bridge,wall,fence,tree,bush,vegetation,road sign

# Fixed fallback distance profile without adding Brain code. This also applies
# to bike/person because Brain intentionally shares the conservative fallback
# path for people and unknown classes.
PORCE_SAFETY_GRB_RATIO=0.0
PORCE_SAFETY_DISTANCE_PERSON_FLOOR_M=15.0
PORCE_SAFETY_DISTANCE_PERSON_MAX_M=15.0
