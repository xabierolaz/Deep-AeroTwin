# Digital Twin / REAL_TWIN workflow defaults.
# Reuse shared MAVLink host/port env vars to point Brain at the real vehicle bridge.

PORCE_SYSTEM_MODE=REAL_TWIN
PORCE_MOCK_MAVLINK=0
PORCE_ENABLE_EVASION=0
PORCE_UNREAL_TELEMETRY_INGEST_ENABLE=0
PORCE_AUDIT_ROOT=%PROJECT_ROOT%\pipeline\logs\zero_trust\real_twin

# --- Replay determinista de vuelo real (Pipeline B) ---
# Ver tools/real_flight_replay/. Descomentar y ajustar para la prueba M_20_1RR:
# PORCE_REPLAY_TELEMETRY_ENABLE=1
# PORCE_VISION_SOURCE=VIDEO_LINK
# PORCE_VISION_VIDEO_LINK_URL=http://127.0.0.1:8099
# PORCE_VISION_VIDEO_LOOP=0
# IMPORTANTE: el video de M_20_1RR se almacena sky-up en portrait (2160x3840);
# el flag rotate=270 del contenedor es enganoso. NO rotar:
# PORCE_VISION_VIDEO_ROTATE=0
# PORCE_VISION_TELEMETRY_REPLAY_FILE=%PROJECT_ROOT%\tools\real_flight_replay\out\trajectory_m20_1rr.csv
# Detector de apoyos reales (portrait, entrenado con track_label_towers.py):
# PORCE_YOLO_MODEL=%PROJECT_ROOT%\tools\real_flight_replay\out\yolo_tower_real_tower_portrait_v1.pt
# Montaje de camara real validado (overlay+backsolve, ver out/camera_mount_fit.json):
# PORCE_CAMERA_MOUNT_YAW_DEG=155
# PORCE_CAMERA_MOUNT_PITCH_DEG=-37
# PORCE_CAMERA_MOUNT_ROLL_DEG=0
# PORCE_CAMERA_VFOV_DEG=77
# PORCE_VISION_IMGSZ=1280
# PORCE_VISION_TARGET_CLASS_NAMES=tower
# PORCE_VISION_DET_CONF=0.25
# PORCE_VISION_PUBLISH_CONF=0.25
# Audit de detecciones para validacion geoespacial (analyze_replay.py):
# PORCE_AUDIT_ROOT=%PROJECT_ROOT%\tools\real_flight_replay\out\audit_replay
