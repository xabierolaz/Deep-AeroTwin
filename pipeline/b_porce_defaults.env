# B Pipeline (REAL_TWIN) overrides.
# This file is loaded on top of `pipeline/porce_defaults.env`.

PORCE_SYSTEM_MODE=REAL_TWIN
PORCE_MOCK_MAVLINK=1
PORCE_ENABLE_EVASION=0

# Vision input for B: external video/mock stream.
PORCE_VISION_SOURCE=VIDEO_FILE
PORCE_VISION_VIDEO_LOOP=1
PORCE_VISION_VIDEO_REOPEN_SLEEP_S=0.25

# Debug UX for non-PIE video playback.
PORCE_VISION_DEBUG_WINDOW=1
PORCE_VISION_DEBUG_DOCK=0

# B does not depend on Unreal->Brain telemetry ingestion by default.
PORCE_UNREAL_TELEMETRY_INGEST_ENABLE=0
