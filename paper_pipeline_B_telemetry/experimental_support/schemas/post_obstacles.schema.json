{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-aerotwin.local/schemas/pipeline-b/post-obstacles.schema.json",
  "title": "Pipeline B POST /api/obstacles payload",
  "type": "object",
  "additionalProperties": true,
  "required": ["obstacles"],
  "properties": {
    "timestamp_s": {
      "type": "number",
      "description": "Optional sender timestamp in seconds."
    },
    "frame_id": {
      "type": ["integer", "string"],
      "description": "Optional source frame identifier."
    },
    "obstacles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obstacleIngest"
      }
    }
  },
  "$defs": {
    "worldM": {
      "type": "object",
      "additionalProperties": false,
      "required": ["north", "east"],
      "properties": {
        "north": { "type": "number" },
        "east": { "type": "number" },
        "up": { "type": ["number", "null"] },
        "z": { "type": ["number", "null"] }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "cx": { "type": "number" },
        "cy": { "type": "number" }
      }
    },
    "uncertainty": {
      "type": "object",
      "description": "Forward-compatible field for the paper evaluation; current Brain may ignore it.",
      "additionalProperties": true,
      "properties": {
        "position_sigma_m": { "type": ["number", "null"] },
        "radius_95_m": { "type": ["number", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "obstacleIngest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "confidence", "source"],
      "properties": {
        "id": { "type": ["integer", "string"] },
        "source_id": { "type": ["integer", "string"] },
        "entity_id": {
          "type": "string",
          "description": "Optional proposed stable id; Brain currently derives source:source_id when possible."
        },
        "source": {
          "type": "string",
          "description": "Recommended values: vision, replay, unreal, screen_capture."
        },
        "type": {
          "type": "string",
          "description": "Canonical target classes for Pipeline B include bike, cow, tower."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "distance": {
          "type": ["number", "null"],
          "description": "Distance in meters when available."
        },
        "lat": { "type": ["number", "null"] },
        "lon": { "type": ["number", "null"] },
        "world_m": { "$ref": "#/$defs/worldM" },
        "world_north_m": { "type": ["number", "null"] },
        "world_east_m": { "type": ["number", "null"] },
        "world_up_m": { "type": ["number", "null"] },
        "yaw_deg": { "type": ["number", "null"] },
        "heading_deg": { "type": ["number", "null"] },
        "azimuth_deg": { "type": ["number", "null"] },
        "yaw_rad": { "type": ["number", "null"] },
        "heading_rad": { "type": ["number", "null"] },
        "bbox": { "$ref": "#/$defs/bbox" },
        "uncertainty": { "$ref": "#/$defs/uncertainty" },
        "timestamp_s": { "type": ["number", "null"] }
      },
      "anyOf": [
        { "required": ["world_m"] },
        { "required": ["world_north_m", "world_east_m"] },
        { "required": ["lat", "lon"] }
      ]
    }
  }
}
