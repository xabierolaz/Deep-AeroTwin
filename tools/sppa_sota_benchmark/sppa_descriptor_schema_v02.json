  "properties": {
    "descriptor_schema": {"const": "SPPA-DESC-0.2"},
    "descriptor_id": {"type": "string"},
    "track": {"type": "object"},
    "semantic": {"type": "object"},
    "evidence": {"type": "object"},
    "pose": {"type": "object"},
    "scale": {"type": "object"},
    "uncertainty": {"type": "object"},
