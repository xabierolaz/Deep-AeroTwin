# Heavy regenerable artifacts — kept locally, not versioned.
# supporting_artifacts/: SOTA generator outputs, Unreal/pipeline captures (~22 GB).
# benchmarks/neural_external_wave/runs/: TripoSR/Hunyuan3D raw mesh runs (~3.4 GB).
# Regeneration requires external TripoSR/Hunyuan3D installs; full table
# verification WITHOUT regeneration is possible via the committed
# benchmarks/neural_external_wave/wave_rows/*.json through
# tools/neural_external_wave/step4_evaluate_wave.py.
supporting_artifacts/
benchmarks/neural_external_wave/runs/

# External sanity check (~750 MB regenerable): downloaded Objaverse/ModelNet40
# meshes, HF cache, and prepared case arrays. Kept in git: scripts/, results/,
# qc/, qualitative/, manifest + CLASS_MAPPING + JSON/MD docs. Regeneration via
# benchmarks/external_mesh_sanity/scripts/ (download URLs in manifest.json).
benchmarks/external_mesh_sanity/meshes/
benchmarks/external_mesh_sanity/cache/
benchmarks/external_mesh_sanity/cases/
